# ---- runtime ----
ENV=local
# testnet = Base Sepolia + Solana devnet. mainnet requires MAINNET_EXECUTION_ENABLED=true AND audits.
NETWORK_MODE=testnet
MAINNET_EXECUTION_ENABLED=false
DATABASE_URL=postgresql+asyncpg://agent98:agent98@localhost:5432/agent98
REDIS_URL=redis://localhost:6379/0
APP_DOMAIN=localhost:3000
APP_ORIGIN=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
ADMIN_WALLETS=[]

# ---- chain RPCs (REQUIRED for real data; public endpoints are rate-limited) ----
BASE_RPC_URL=https://sepolia.base.org
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- deployed pass contracts (fill after scripts/deploy-*.sh) ----
BASE_PASS_ADDRESS=
BASE_PASS_DEPLOY_BLOCK=0
SOLANA_PASS_PROGRAM_ID=ARd3pfR6GHqpLYr7sacHgjNwwagkzN15qmoq2GnHyw2Z

# ---- optional services ----
# Without OPENAI_API_KEY the deterministic parser and summaries are used (fully functional).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JUPITER_API_URL=https://lite-api.jup.ag
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- policy defaults (users can only tighten) ----
DEFAULT_MAX_TX_USD=250
DEFAULT_DAILY_LIMIT_USD=1000
MAX_SLIPPAGE_BPS=500
QUOTE_TTL_SECONDS=30
SIMULATION_TTL_SECONDS=45
APPROVAL_TTL_SECONDS=90
